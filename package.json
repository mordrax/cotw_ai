{
  "name": "cotw_ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Castle of the Winds — AI-agent-driven rewrite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "bun scripts/validate.ts"
  },
  "dependencies": {
    "bitecs": "^0.3.40",
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
